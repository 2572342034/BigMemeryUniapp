/* 水平间距 */
.register-container.data-v-838b72c9 {
  min-height: 100vh;
  padding: 0 50rpx;
  background: linear-gradient(160deg, #4a90ff 0%, #6aa9ff 45%, #f5f7fa 45%);
  box-sizing: border-box;
}

/* Logo */
.logo-box.data-v-838b72c9 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
  padding-bottom: 40rpx;
}
.logo.data-v-838b72c9 {
  width: 130rpx;
  height: 130rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}
.welcome.data-v-838b72c9 {
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
}
.desc.data-v-838b72c9 {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单卡片 */
.form-card.data-v-838b72c9 {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.06);
}

/* 注册按钮 */
.register-btn.data-v-838b72c9 {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #4a90ff;
  color: #fff;
  font-size: 34rpx;
  border-radius: 45rpx;
  border: none;
  margin-top: 20rpx;
}
.register-btn[disabled].data-v-838b72c9 {
  opacity: 0.6;
}

/* 登录入口 */
.login-entry.data-v-838b72c9 {
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #666;
}
.link.data-v-838b72c9 {
  color: #4a90ff;
  font-weight: bold;
  margin-left: 10rpx;
  text-decoration: underline;
}